{
  "name": "@daformat/point-and-shoot",
  "version": "1.0.1",
  "license": "Zero-Clause BSD",
  "description": "point-and-shoot, a zero-dependency library to point at anything on a page and capture it: a spotlight morphs onto the block under the pointer, a click shoots it, a drag captures an area. Lifted out of Glea.",
  "keywords": [
    "point-and-shoot",
    "capture",
    "picker",
    "element-picker",
    "spotlight",
    "highlight",
    "inspector",
    "selection",
    "screenshot",
    "markdown",
    "clipper"
  ],
  "homepage": "https://github.com/daformat/point-and-shoot",
  "bugs": {
    "url": "https://github.com/daformat/point-and-shoot/issues"
  },
  "author": "Mathieu Jouhet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daformat/point-and-shoot.git"
  },
  "scripts": {
    "build": "tsc && node scripts/build-iife.mjs",
    "ci": "pnpm build && pnpm typecheck && pnpm lint:js && pnpm format:check && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "local-release": "changeset version && changeset publish",
    "prepublishOnly": "npm run ci",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-utils.ts"
  ],
  "sideEffects": [
    "./dist/point-and-shoot.iife.js",
    "./dist/point-and-shoot.iife.min.js"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "markdown": [
        "./dist/markdown.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./iife": "./dist/point-and-shoot.iife.js",
    "./iife.min": "./dist/point-and-shoot.iife.min.js",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@10.4.0+sha512.6b849d0787d97f8f4e1f03a9b8ff8f038e79e153d6f11ae539ae7c435ff9e796df6a862c991502695c7f9e8fac8aeafc1ac5a8dab47e36148d183832d886dd52",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
